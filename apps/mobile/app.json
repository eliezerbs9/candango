{
  "expo": {
    "name": "Candango",
    "slug": "candango",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "candango",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.bsbtechub.candango"
    },
    "android": {
      "package": "com.bsbtechub.candango",
      "adaptiveIcon": {
        "backgroundColor": "#d9552c",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 128
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "expo-font",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Candango uses your photos to set your profile photo and workspace logo.",
          "cameraPermission": "Candango uses your camera to take a profile photo."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
