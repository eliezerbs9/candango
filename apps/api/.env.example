# Candango API — environment variables (copy to .env and fill in; .env is gitignored)
# See vault: Candango/06 - Delivery/External Setup & Credentials.md

# Core
# Runtime connection: a NON-superuser role (subject to row-level security).
DATABASE_URL=postgresql://candango_app:candango@localhost:5432/candango?schema=public
# Migrations/introspection: the owner/superuser (can ALTER tables + RLS policies).
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/candango?schema=public
REDIS_URL=redis://localhost:6379
JWT_SECRET=
APP_URL=http://localhost:3000
API_URL=http://localhost:4000/v1
# Public marketing site origin (cadido-website) — allowed by CORS for the /contact form.
SITE_URL=http://localhost:4321

# Contact form (cadido-website /contact → POST /v1/contact → Brevo via the worker)
CONTACT_INBOX=hello@candango.app
# Optional anti-spam: Cloudflare Turnstile secret (server-side verify). Honeypot works without it.
TURNSTILE_SECRET=

# Google OAuth (Calendar + Gmail) — see External Setup §1
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/v1/integrations/google/callback
# "Sign in with Google" callback (register this redirect URI in the same OAuth client).
GOOGLE_AUTH_REDIRECT_URI=http://localhost:4000/v1/auth/google/callback
# Encrypts OAuth tokens at rest (AES-256-GCM). Optional in dev — falls back to JWT_SECRET.
# Generate one with: openssl rand -hex 32
GOOGLE_TOKEN_ENC_KEY=

# QuickBooks Online — see External Setup §2
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=http://localhost:4000/v1/integrations/quickbooks/callback
QBO_ENVIRONMENT=sandbox
# Intuit Webhooks "Verifier Token" (from the app's Development/Production keys) — used to verify
# the intuit-signature on inbound QuickBooks webhooks (POST /v1/public/quickbooks/webhook).
QBO_WEBHOOK_VERIFIER_TOKEN=

# CompanyCam — job-site photos (optional; per-workspace OAuth). Register an app at
# https://app.companycam.com/access-keys/applications and add the redirect URI below.
# Access tokens last ~2h and the refresh token ROTATES on every refresh — both are re-stored each time.
COMPANYCAM_CLIENT_ID=
COMPANYCAM_CLIENT_SECRET=
COMPANYCAM_REDIRECT_URI=http://localhost:4000/v1/integrations/companycam/callback
# Override only to move off the current API (support for api.companycam.com/v2 ends 2027-09-01).
# COMPANYCAM_API_URL=https://api.companycam.com/v2

# Stripe — see External Setup §3
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Note: email SENDING (Brevo: BREVO_API_KEY / EMAIL_FROM / EMAIL_FROM_NAME) lives in
# apps/workers/.env — the worker sends, the API only enqueues. The contact-form
# recipient (CONTACT_INBOX) is set above.

# File uploads (image/document custom fields) — DigitalOcean Spaces (S3-compatible).
# One shared bucket for all workspaces; objects are keyed by org and access is signed.
# Leave blank to disable file uploads. Endpoint is the REGION endpoint (no bucket in it).
SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
SPACES_REGION=nyc3
SPACES_BUCKET=
SPACES_KEY=
SPACES_SECRET=

# E-signature — self-hosted Documenso (open source; its API is free + unlimited when self-hosted).
# Leave blank to disable e-sign.
# Local dev: `docker-compose -f docker/documenso/compose.yml --env-file docker/documenso/.env up -d`,
# open http://localhost:3060, sign up, then Settings → API Tokens to copy a token. Add a webhook
# (Settings → Webhooks) → http://host.docker.internal:4000/v1/public/documenso/webhook
DOCUMENSO_URL=http://localhost:3060
DOCUMENSO_API_KEY=
# Set the SAME value as the webhook's "Secret" field in Documenso (Settings → Webhooks).
# Documenso echoes it back in the `X-Documenso-Secret` header; we compare it in constant time.
# Required — with this blank every inbound webhook is rejected (status still self-heals via reconcile).
DOCUMENSO_WEBHOOK_SECRET=

# HTML→PDF rendering for generating signable documents from the visual builder.
# Run `docker compose up -d gotenberg` (from the repo root). Leave blank to disable builder-mode
# document generation (upload-PDF templates still work without it).
GOTENBERG_URL=http://localhost:3005
